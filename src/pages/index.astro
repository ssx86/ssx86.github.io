<!-- ═══════════ 总控台 ═══════════ -->
<div id="palette-backdrop">
  <div id="palette" role="dialog" aria-label="总控台">
    <div class="in">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dfe5f2" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="pal-input" type="text" placeholder="总控台：跳转或打开…（试试 rl）" autocomplete="off">
      <span id="pal-esc">ESC</span>
    </div>
    <div id="pal-list"></div>
    <div id="pal-empty" hidden>没有匹配项</div>
  </div>
</div>

<script is:inline>
/* ═════════════════════════════════════════════
   SSX86 · 个人空间
   三体运动背景（CPU 积分 + GPU 渲染）· 零依赖
   性能策略：30fps 锁定 / 低分辨率渲染 / 自适应降档
   ═════════════════════════════════════════════ */
(() => {
  "use strict";
  const RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const FINE = matchMedia("(pointer: fine)").matches;

  /* ── 1. 三体模拟（软化的引力 + 向心束缚，保证永远 bounded） ── */
  const SUN_COLORS = [[.20,.75,.95],[.66,.52,.98],[.95,.45,.72]]; // cyan violet pink
  const MASS = [1.0, 1.35, 0.9];
  let P = [[-.42,-.18],[.40,-.26],[.05,.44]];   // 位置（uv 空间比例）
  let V = [[.11,-.16],[-.09,.13],[-.04,.05]];   // 速度
  let eraTimeScale = .55, simTime = 0;

  function stepSim(h) {
    const G = .30, EPS = .035, K = .012;
    for (let i = 0; i < 3; i++) {
      let ax = -K * P[i][0], ay = -K * P[i][1];
      for (let j = 0; j < 3; j++) {
        if (i === j) continue;
        const dx = P[j][0] - P[i][0], dy = P[j][1] - P[i][1];
        const d2 = dx*dx + dy*dy + EPS;
        const inv = MASS[j] * G / (d2 * Math.sqrt(d2));
        ax += dx * inv; ay += dy * inv;
      }
      V[i][0] += ax * h; V[i][1] += ay * h;
    }
    for (let i = 0; i < 3; i++) { P[i][0] += V[i][0] * h; P[i][1] += V[i][1] * h; }
  }

  /* ── 2. WebGL 渲染 ── */
  const canvas = document.getElementById("gl");
  let gl = canvas.getContext("webgl", { antialias:false, alpha:false })
        || canvas.getContext("experimental-webgl");
  if (!gl) { canvas.style.display = "none"; document.getElementById("gl-fallback").style.display = "block"; }

  const VERT = "attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}";
  const FRAG = `
precision mediump float;
uniform vec2 u_res;uniform float u_time;uniform vec2 u_mouse;uniform vec2 u_suns[3];
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
vec3 SUNCOL(int i){
  if(i==0)return vec3(.20,.75,.95);
  if(i==1)return vec3(.66,.52,.98);
  return vec3(.95,.45,.72);
}
void main(){
  vec2 uv=(gl_FragCoord.xy*2.-u_res)/min(u_res.x,u_res.y);
  vec2 m=u_mouse*2.-1.;m.x*=u_res.x/u_res.y;
  float md=length(uv-m);
  uv+=(m-uv)*.05*exp(-md*3.5);
  vec3 col=vec3(.008,.010,.022);
  /* 两层静态星野（近层微闪） */
  for(int L=0;L<2;L++){
    float scale=L==0?26.:64.;
    vec2 g=uv*scale;
    vec2 id=floor(g),f=fract(g)-.5;
    float h=hash(id+float(L)*17.31);
    if(h>.902){
      vec2 off=vec2(hash(id+1.7),hash(id+9.1))-.5;
      float d=length(f-off*.8);
      float tw=L==0?(.65+.35*sin(u_time*2.2+h*40.)):.8;
      col+=vec3(.9,.93,1.)*tw*smoothstep(.05,.0,d)*step(.902,h)*.8;
    }
  }
  /* 三颗恒星 */
  for(int i=0;i<3;i++){
    float d=length(uv-u_suns[i]);
    float core=exp(-d*22.)*1.5;
    float halo=.16/(d*d*34.+.015);
    col+=SUNCOL(i)*(core+halo);
    col+=SUNCOL(i)*.10*exp(-d*4.5);   /* 大范围染色 */
  }
  float vg=1.-dot(uv*.5,uv*.5);
  col*=clamp(vg,.12,1.);
  gl_FragColor=vec4(col,1.);
}`;

  let uRes,uTime,uMouse,uSuns;
  if (gl) {
    const mk=(t,s)=>{const sh=gl.createShader(t);gl.shaderSource(sh,s);gl.compileShader(sh);
      if(!gl.getShaderParameter(sh,gl.COMPILE_STATUS)){console.warn(gl.getShaderInfoLog(sh));return null;}return sh;};
    const vs=mk(gl.VERTEX_SHADER,VERT),fs=mk(gl.FRAGMENT_SHADER,FRAG);
    if(vs&&fs){
      const prog=gl.createProgram();
      gl.attachShader(prog,vs);gl.attachShader(prog,fs);gl.linkProgram(prog);gl.useProgram(prog);
      const buf=gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER,buf);
      gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);
      const loc=gl.getAttribLocation(prog,"p");
      gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
      uRes=gl.getUniformLocation(prog,"u_res");uTime=gl.getUniformLocation(prog,"u_time");
      uMouse=gl.getUniformLocation(prog,"u_mouse");uSuns=gl.getUniformLocation(prog,"u_suns");
    } else { gl=null; canvas.style.display="none"; document.getElementById("gl-fallback").style.display="block"; }
  }

  /* 性能：分辨率档位 + 30fps 锁 + 自适应 */
  let renderScale=1.0, dprCap=1.25;
  const rscaleEl=document.getElementById("rscale");
  function resize(){
    if(!gl)return;
    const s=Math.min(devicePixelRatio||1,dprCap)*renderScale;
    const w=Math.round(canvas.clientWidth*s),h=Math.round(canvas.clientHeight*s);
    if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h;gl.viewport(0,0,w,h);}
  }

  let mouse=[.5,.5],mouseT=[.5,.5];
  let visible=!document.hidden,heroVisible=true;
  document.addEventListener("visibilitychange",()=>visible=!document.hidden);
  new IntersectionObserver(es=>heroVisible=es[0].isIntersecting).observe(document.getElementById("hero"));

  const fpsEl=document.getElementById("fps");
  let frames=0,lastFpsT=performance.now(),fpsAvg=60,lastRender=0,checkT=performance.now();

  let rmDrawn=false;
  function frame(now){
    requestAnimationFrame(frame);
    if(RM){
      if(gl&&!rmDrawn){
        resize();stepSim(6);
        gl.uniform2f(uRes,canvas.width,canvas.height);gl.uniform1f(uTime,20);gl.uniform2f(uMouse,.5,.5);
        const asp=canvas.width/canvas.height,s=Math.min(asp,1);
        gl.uniform2fv(uSuns,new Float32Array([P[0][0]*s,P[0][1],P[1][0]*s,P[1][1],P[2][0]*s,P[2][1]]));
        gl.drawArrays(gl.TRIANGLES,0,3);rmDrawn=true;
      }
      return;
    }
    const MIN_DT=1000/30;
    if(now-lastRender<MIN_DT) return;
    const dt=Math.min(now-lastRender,100);lastRender=now;
    if(!(gl&&visible&&heroVisible)) return;

    /* 物理积分（固定小步长，era 控制快慢） */
    const simDt=(dt/1000)*eraTimeScale;
    const steps=Math.max(1,Math.min(4,Math.ceil(simDt/0.016)));
    for(let i=0;i<steps;i++) stepSim(simDt/steps);
    simTime+=simDt;

    resize();
    mouse[0]+=(mouseT[0]-mouse[0])*.08;mouse[1]+=(mouseT[1]-mouse[1])*.08;
    gl.uniform2f(uRes,canvas.width,canvas.height);
    gl.uniform1f(uTime,simTime);
    gl.uniform2f(uMouse,mouse[0],mouse[1]);
    const asp=canvas.width/canvas.height;
    const suns=new Float32Array([
      P[0][0]*Math.min(asp,1.)*1.0,P[0][1],
      P[1][0]*Math.min(asp,1.)*1.0,P[1][1],
      P[2][0]*Math.min(asp,1.)*1.0,P[2][1]
    ]);
    gl.uniform2fv(uSuns,suns);
    gl.drawArrays(gl.TRIANGLES,0,3);

    frames++;
    if(now-lastFpsT>500){
      const f=frames*1000/(now-lastFpsT);
      fpsEl.textContent=String(Math.round(f)).padStart(2,"0");
      fpsAvg=fpsAvg*.5+f*.5;frames=0;lastFpsT=now;
    }
    /* 自适应降档 / 升档（每 4s 评估一次） */
    if(now-checkT>4000){
      if(fpsAvg<34&&renderScale>.45){renderScale=Math.max(.45,renderScale-.2);rscaleEl.textContent=renderScale.toFixed(1)+"×";}
      else if(fpsAvg>55&&renderScale<1){renderScale=Math.min(1,renderScale+.2);rscaleEl.textContent=renderScale.toFixed(1)+"×";}
      checkT=now;
    }
  }
  requestAnimationFrame(frame);

  addEventListener("mousemove",e=>{
    mouseT[0]=e.clientX/innerWidth;mouseT[1]=1-e.clientY/innerHeight;
    const cx=document.getElementById("coord-x"),cy=document.getElementById("coord-y");
    if(cx&&!RM){cx.textContent=(e.clientX/innerWidth).toFixed(3);cy.textContent=(e.clientY/innerHeight).toFixed(3);}
  },{passive:true});

  /* ── 3. 舰船时钟 + 纪元 ── */
  const clockEl=document.getElementById("clock");
  function tickClock(){const d=new Date();clockEl.textContent=[d.getHours(),d.getMinutes(),d.getSeconds()].map(n=>String(n).padStart(2,"0")).join(":");}
  tickClock();setInterval(tickClock,1000);

  const eraEl=document.getElementById("era");
  function switchEra(){
    const chaotic=Math.random()<.5;
    eraTimeScale=chaotic?1.5:.55;
    eraEl.textContent=chaotic?"乱纪元":"恒纪元";
    eraEl.classList.toggle("chaotic",chaotic);
    setTimeout(switchEra,90000+Math.random()*150000);
  }
  setTimeout(switchEra,60000+Math.random()*60000);

  /* ── 4. 乱序解码 ── */
  const GLYPHS="!<>-_\\/[]{}—=+*^?#01";
  function scramble(el,finalText,dur=800){
    if(RM){el.textContent=finalText;return;}
    const t0=performance.now();
    (function tick(now){
      const p=Math.min((now-t0)/dur,1);
      const settled=Math.floor(p*p*finalText.length);
      let out=finalText.slice(0,settled);
      for(let i=settled;i<finalText.length;i++)out+=finalText[i]===" "?" ":GLYPHS[(Math.random()*GLYPHS.length)|0];
      el.textContent=out;
      if(p<1)requestAnimationFrame(tick);else el.textContent=finalText;
    })(t0);
  }
  const h1=document.querySelector("h1.title");
  if(h1)setTimeout(()=>scramble(h1,h1.dataset.scrambleText||"SSX86",1000),150);
  document.querySelectorAll("[data-scramble]").forEach(el=>{
    if(el===h1)return;
    const txt=el.textContent;
    new IntersectionObserver((es,obs)=>{if(es[0].isIntersecting){scramble(el,txt,650);obs.disconnect();}},{threshold:.6}).observe(el);
  });

  /* ── 5. 滚动进场 + 进度条 ── */
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);}}),{threshold:.12,rootMargin:"0px 0px -40px 0px"});
  document.querySelectorAll(".reveal").forEach(el=>io.observe(el));
  const bar=document.getElementById("progress");
  addEventListener("scroll",()=>{const h=document.documentElement;bar.style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+"%";},{passive:true});

  /* ── 6. 倾斜 + 磁吸 ── */
  if(FINE&&!RM){
    document.querySelectorAll("[data-tilt]").forEach(card=>{
      card.addEventListener("mousemove",e=>{
        const r=card.getBoundingClientRect();
        const x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;
        card.style.transform=`perspective(800px) rotateX(${(0.5-y)*6}deg) rotateY(${(x-0.5)*8}deg) translateY(-3px)`;
        card.style.setProperty("--gx",x*100+"%");card.style.setProperty("--gy",y*100+"%");
      },{passive:true});
      card.addEventListener("mouseleave",()=>card.style.transform="");
    });
    document.querySelectorAll("[data-magnetic]").forEach(btn=>{
      btn.addEventListener("mousemove",e=>{
        const r=btn.getBoundingClientRect();
        btn.style.transform=`translate(${(e.clientX-r.left-r.width/2)*.18}px,${(e.clientY-r.top-r.height/2)*.3}px)`;
      },{passive:true});
      btn.addEventListener("mouseleave",()=>btn.style.transform="");
    });
  }

  /* ── 7. 自定义光标 ── */
  if(FINE&&!RM){
    document.body.classList.add("cur-on");
    const dot=document.querySelector(".cur-dot"),ring=document.querySelector(".cur-ring");
    let rx=0,ry=0,tx=0,ty=0;
    addEventListener("mousemove",e=>{tx=e.clientX;ty=e.clientY;},{passive:true});
    (function loop(){rx+=(tx-rx)*.16;ry+=(ty-ry)*.16;
      dot.style.transform=`translate(${tx-3}px,${ty-3}px)`;
      ring.style.transform=`translate(${rx-17}px,${ry-17}px)`;
      requestAnimationFrame(loop);})();
    document.querySelectorAll("a,button,[data-magnetic],.launch").forEach(el=>{
      el.addEventListener("mouseenter",()=>document.body.classList.add("cur-hover"));
      el.addEventListener("mouseleave",()=>document.body.classList.remove("cur-hover"));
    });
  }

  /* ── 8. 数字键发射 ── */
  const HOTKEYS={};
  document.querySelectorAll("[data-hotkey]").forEach(el=>HOTKEYS[el.dataset.hotkey]=el.href);

  /* ── 9. 总控台 ── */
  const ITEMS=[
    {ic:"NAV",label:"控制台",hint:"#console",act:()=>location.hash="#console"},
    {ic:"NAV",label:"遗迹",hint:"#archive",act:()=>location.hash="#archive"},
    {ic:"OPEN",label:"强化学习野外指南",hint:"rl-field-guide",url:"https://ssx86.github.io/rl-field-guide/"},
    {ic:"OPEN",label:"RL 训练实验场",hint:"rl-training-lab",url:"https://ssx86.github.io/rl-training-lab/"},
    {ic:"OPEN",label:"老友记台词库",hint:"friends-scripts",url:"https://ssx86.github.io/friends-scripts/"},
    {ic:"OPEN",label:"舒尔特训练场",hint:"schulte",url:"https://ssx86.github.io/schulte-lab/"},
    {ic:"OPEN",label:"sslang · 玩具语言",hint:"sslang",url:"https://github.com/ssx86/sslang"},
    {ic:"OPEN",label:"nn · 手写神经网络",hint:"nn",url:"https://github.com/ssx86/nn"},
    {ic:"OPEN",label:"自然选择（深空）",hint:"nature-selection",url:"https://ssx86.github.io/nature-selection/"},
    {ic:"OPEN",label:"GitHub",hint:"github",url:"https://github.com/ssx86"},
  ];
  const bd=document.getElementById("palette-backdrop");
  const input=document.getElementById("pal-input");
  const list=document.getElementById("pal-list");
  const empty=document.getElementById("pal-empty");
  let filtered=ITEMS,active=0;
  function render(){
    const q=input.value.trim().toLowerCase();
    filtered=q?ITEMS.filter(it=>(it.label+it.hint+it.ic).toLowerCase().includes(q)):ITEMS;
    active=Math.min(active,Math.max(filtered.length-1,0));
    list.innerHTML=filtered.map((it,i)=>
      `<div class="item${i===active?" on":""}" data-i="${i}"><span class="ic">${it.ic}</span>${it.label}<span class="h">${it.hint}</span></div>`).join("");
    empty.hidden=filtered.length>0;
    list.querySelectorAll(".item").forEach(el=>{
      el.addEventListener("mouseenter",()=>{active=+el.dataset.i;render();});
      el.addEventListener("click",()=>run(+el.dataset.i));
    });
  }
  function run(i){const it=filtered[i];if(!it)return;closePal();if(it.url)window.open(it.url,"_blank","noopener");else it.act();}
  function openPal(){bd.classList.add("open");input.value="";active=0;render();input.focus();}
  function closePal(){bd.classList.remove("open");}
  addEventListener("keydown",e=>{
    const typing=e.target.tagName==="INPUT"||e.target.tagName==="TEXTAREA";
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k"){e.preventDefault();bd.classList.contains("open")?closePal():openPal();return;}
    if(!typing&&!bd.classList.contains("open")&&HOTKEYS[e.key]){window.open(HOTKEYS[e.key],"_blank","noopener");return;}
    if(!bd.classList.contains("open"))return;
    if(e.key==="Escape")closePal();
    if(e.key==="ArrowDown"){e.preventDefault();active=Math.min(active+1,filtered.length-1);render();}
    if(e.key==="ArrowUp"){e.preventDefault();active=Math.max(active-1,0);render();}
    if(e.key==="Enter")run(active);
  });
  input.addEventListener("input",render);
  bd.addEventListener("click",e=>{if(e.target===bd)closePal();});
  document.getElementById("pal-open").addEventListener("click",openPal);
  document.getElementById("kbd-hint").addEventListener("click",openPal);

  /* ── 10. 控制台彩蛋 ── */
  console.log(
    "%c 不要回答 %c 不要回答！！ 不要回答！！！ %c\n"+
    "  —— 此处是 SSX86 的个人空间。三体模拟在后台运行，藏好自己，做好清理。\n"+
    "  ⌘K / Ctrl+K 打开总控台。GitHub: https://github.com/ssx86\n",
    "background:#f472b6;color:#1a0b12;font-weight:bold;padding:3px 6px;border-radius:4px 0 0 4px",
    "background:#a78bfa;color:#120b1e;font-weight:bold;padding:3px 6px;border-radius:0 4px 4px 0",
    "color:#8a93ab"
  );
})();
</script>
